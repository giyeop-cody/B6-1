[
  [
    "CloudTrail",
    [
      "cloudtrail",
      "lookup-events",
      "--lookup-attributes",
      "AttributeKey=ResourceName,AttributeValue=b6-1-learning",
      "--max-results",
      "50",
      "--query",
      "Events[].{Time:EventTime,Event:EventName,User:Username}"
    ]
  ],
  [
    "Stack",
    [
      "cloudformation",
      "list-stacks",
      "--query",
      "StackSummaries[?StackName==`b6-1-learning`].{Name:StackName,Status:StackStatus}"
    ]
  ],
  [
    "EC2",
    [
      "ec2",
      "describe-instances",
      "--filters",
      "Name=instance-state-name,Values=pending,running,stopping,stopped,shutting-down",
      "--query",
      "length(Reservations[].Instances[])"
    ]
  ],
  [
    "EBS",
    [
      "ec2",
      "describe-volumes",
      "--query",
      "length(Volumes)"
    ]
  ],
  [
    "VPC",
    [
      "ec2",
      "describe-vpcs",
      "--filters",
      "Name=tag:Project,Values=b6-1",
      "--query",
      "length(Vpcs)"
    ]
  ],
  [
    "Subnet",
    [
      "ec2",
      "describe-subnets",
      "--filters",
      "Name=tag:Project,Values=b6-1",
      "--query",
      "length(Subnets)"
    ]
  ],
  [
    "SecurityGroup",
    [
      "ec2",
      "describe-security-groups",
      "--filters",
      "Name=tag:Project,Values=b6-1",
      "--query",
      "length(SecurityGroups)"
    ]
  ],
  [
    "RouteTable",
    [
      "ec2",
      "describe-route-tables",
      "--filters",
      "Name=tag:Project,Values=b6-1",
      "--query",
      "length(RouteTables)"
    ]
  ],
  [
    "IGW",
    [
      "ec2",
      "describe-internet-gateways",
      "--filters",
      "Name=tag:Project,Values=b6-1",
      "--query",
      "length(InternetGateways)"
    ]
  ],
  [
    "EIP",
    [
      "ec2",
      "describe-addresses",
      "--query",
      "length(Addresses)"
    ]
  ],
  [
    "Snapshot",
    [
      "ec2",
      "describe-snapshots",
      "--owner-ids",
      "self",
      "--query",
      "length(Snapshots)"
    ]
  ],
  [
    "NAT",
    [
      "ec2",
      "describe-nat-gateways",
      "--filter",
      "Name=state,Values=pending,available,deleting,failed",
      "--query",
      "length(NatGateways)"
    ]
  ],
  [
    "ELB",
    [
      "elbv2",
      "describe-load-balancers",
      "--query",
      "length(LoadBalancers)"
    ]
  ],
  [
    "RDS",
    [
      "rds",
      "describe-db-instances",
      "--query",
      "length(DBInstances)"
    ]
  ],
  [
    "Cost",
    [
      "ce",
      "get-cost-and-usage",
      "--time-period",
      "Start=2026-09-24,End=2026-09-25",
      "--granularity",
      "DAILY",
      "--metrics",
      "UnblendedCost",
      "--query",
      "ResultsByTime[].{Time:TimePeriod,Cost:Total,Estimated:Estimated}"
    ]
  ]
]