{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRoots",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateInternetGateway",
        "ec2:CreateLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:vpc/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:RequestTag/Project": "b6-1"
        }
      }
    },
    {
      "Sid": "CreateChildren",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:subnet/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:route-table/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:RequestTag/Project": "b6-1"
        }
      }
    },
    {
      "Sid": "UseOwnVpcForChildren",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:ResourceTag/Project": "b6-1",
          "aws:ResourceTag/aws:cloudformation:stack-name": "b6-1-learning"
        }
      }
    },
    {
      "Sid": "ManageOwnedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:TerminateInstances",
        "ec2:DeleteLaunchTemplate",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:DeleteLaunchTemplateVersions"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:vpc/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:subnet/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:route-table/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:security-group/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:launch-template/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:ResourceTag/Project": "b6-1",
          "aws:ResourceTag/aws:cloudformation:stack-name": "b6-1-learning"
        }
      }
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:vpc/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:subnet/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:route-table/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:security-group/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:launch-template/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:instance/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:volume/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateLaunchTemplate",
            "RunInstances"
          ],
          "aws:RequestTag/Project": "b6-1"
        }
      }
    },
    {
      "Sid": "LaunchSmallInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:RequestTag/Project": "b6-1",
          "ec2:InstanceType": "t3.micro",
          "ec2:MetadataHttpTokens": "required",
          "ec2:Tenancy": "default"
        }
      }
    },
    {
      "Sid": "LaunchEncryptedVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:RequestTag/Project": "b6-1",
          "ec2:VolumeType": "gp3"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "8"
        }
      }
    },
    {
      "Sid": "LaunchNewTaggedInterface",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:RequestTag/Project": "b6-1"
        }
      }
    },
    {
      "Sid": "UseOwnLaunchDependencies",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:000000000000:subnet/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:security-group/*",
        "arn:aws:ec2:ap-northeast-2:000000000000:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "aws:ResourceTag/Project": "b6-1",
          "aws:ResourceTag/aws:cloudformation:stack-name": "b6-1-learning"
        }
      }
    },
    {
      "Sid": "UseAmazonImage",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2::image/ami-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "ec2:Owner": "amazon"
        }
      }
    },
    {
      "Sid": "UseLearningKey",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:000000000000:key-pair/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:CalledViaFirst": "cloudformation.amazonaws.com",
          "ec2:KeyPairName": "b6-1-key"
        }
      }
    }
  ]
}
